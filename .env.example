# Django
# Generate a strong random value: `python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"`
DJANGO_SECRET_KEY=change-me
DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database (PostgreSQL)
DATABASE_NAME=skillswap_db
DATABASE_USER=postgres
DATABASE_PASSWORD=change-me
DATABASE_HOST=localhost
DATABASE_PORT=5432

# Redis / Celery
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_MINUTES=30
JWT_REFRESH_TOKEN_DAYS=30

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Email (local default: print to console)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=SkillSwap <no-reply@skillswap.local>

# OTP
OTP_CODE_VALIDITY_SECONDS=600

# AI
AI_API_KEY=

# Payments (Stripe). When STRIPE_API_KEY is empty the backend runs in
# simulation mode so local development needs no credentials.
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=http://localhost:5173/orders/success
STRIPE_CANCEL_URL=http://localhost:5173/orders/cancelled

# Frontend build (Docker only)
# Relative path means the SPA talks to the API through the nginx proxy.
VITE_API_URL=/api/v1